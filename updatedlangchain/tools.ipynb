   "source": [
    "from dotenv import load_dotenv\n",
    "from langchain_groq import ChatGroq\n",
    "\n",
    "load_dotenv()\n",
    "\n",
    "model = ChatGroq(\n",
    "    model=\"openai/gpt-oss-20b\",\n",
    "    temperature=0\n",
    ")\n",
    "\n",
    "response = model.invoke(\"Explain LangChain in one sentence.\")\n",
    "\n",
    "print(response.content)"
   ]
